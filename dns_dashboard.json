{
  "dashboard": {
    "id": 51,
    "uid": "dns-query-logs",
    "title": "DNS Query Logs",
    "tags": ["dns", "imperial"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "10s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "DNS Query Rate (per minute)",
        "type": "timeseries",
        "datasource": { "type": "mysql", "uid": "dfspb6k71nmrka" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "rawSql": "SELECT UNIX_TIMESTAMP(timestamp) AS time_sec, COUNT(*) AS value FROM dns_query_logs WHERE $__timeFilter(timestamp) GROUP BY UNIX_TIMESTAMP(timestamp) DIV 60 ORDER BY time_sec ASC",
            "format": "time_series",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Top 10 Domains",
        "type": "barchart",
        "datasource": { "type": "mysql", "uid": "dfspb6k71nmrka" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "rawSql": "SELECT domain_name AS domain, COUNT(*) AS queries FROM dns_query_logs WHERE $__timeFilter(timestamp) GROUP BY domain_name ORDER BY queries DESC LIMIT 10",
            "format": "table",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Query Types",
        "type": "piechart",
        "datasource": { "type": "mysql", "uid": "dfspb6k71nmrka" },
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
        "targets": [
          {
            "rawSql": "SELECT query_type, COUNT(*) AS queries FROM dns_query_logs WHERE $__timeFilter(timestamp) GROUP BY query_type",
            "format": "table",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Total Queries (last 1h)",
        "type": "stat",
        "datasource": { "type": "mysql", "uid": "dfspb6k71nmrka" },
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
        "targets": [
          {
            "rawSql": "SELECT COUNT(*) AS total FROM dns_query_logs WHERE $__timeFilter(timestamp)",
            "format": "table",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Unique Clients",
        "type": "stat",
        "datasource": { "type": "mysql", "uid": "dfspb6k71nmrka" },
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
        "targets": [
          {
            "rawSql": "SELECT COUNT(DISTINCT client_ip) AS clients FROM dns_query_logs WHERE $__timeFilter(timestamp)",
            "format": "table",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Recent Queries",
        "type": "table",
        "datasource": { "type": "mysql", "uid": "dfspb6k71nmrka" },
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
        "targets": [
          {
            "rawSql": "SELECT timestamp AS \"Time\", client_ip AS \"Client\", domain_name AS \"Domain\", query_type AS \"Type\", response_status AS \"Status\" FROM dns_query_logs ORDER BY timestamp DESC LIMIT 50",
            "format": "table",
            "refId": "A"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
